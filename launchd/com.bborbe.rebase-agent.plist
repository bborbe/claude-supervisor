<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rebase agent — one sweep every 15 minutes with no Claude session as its parent.

  WHY A LAUNCHD AGENT, and not a slash command or an in-session `Monitor`:

    * The goal's SC1 is "an open PR whose branch is behind master is identified within one
      poll interval with NO HUMAN STARTING THE RUN". A slash command is human-started by
      construction, so it cannot satisfy that criterion at all.
    * An in-session `Monitor` dies with its session, so the sweep would stop exactly when
      nobody is watching — which is the whole population it exists for.
    * `StartInterval` gives a FRESH PROCESS per tick, so there is no loop to die. Same shape
      as `com.bborbe.fleet-keeper` and `com.bborbe.fleet-digest-notify`.

  The cadence is 900 s because that is the fleet's own round interval: a behind-master PR
  discovered on the same tick the fleet round runs is discovered in time to be handed to
  the same operator turn.

  ⚠️ WHAT THIS JOB DOES NOT DO: it never pushes and never merges. It writes one push line
  per PR into `~/.local/state/claude-supervisor/rebase-agent/latest.json` and prints them.
  The force-push stays the operator's by standing rule, so this is a report, not an action.

  Install:
    cp launchd/com.bborbe.rebase-agent.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.bborbe.rebase-agent.plist

  Reload after an upgrade:
    launchctl kickstart -k gui/$UID/com.bborbe.rebase-agent

  The script path is the marketplace clone, not a version-pinned cache dir, for the same
  reason `fleet-keeper` uses it: a cache path would pin the agent to one release and
  silently run stale code after every upgrade.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bborbe.rebase-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/bborbe/.claude/plugins/marketplaces/claude-supervisor/scripts/rebase-agent.py</string>
    </array>

    <!--
      ⚠️ The PATH is not decoration: launchd gives a job no login shell, so it never reads
      ~/.zshrc, and anything not on this list is simply not found. `gh` lives in
      /opt/homebrew/bin and `git` in /usr/bin — measured, not assumed — and the sweep fails
      every repo with `UNKNOWN` without them. /opt/homebrew/bin is listed AFTER the system
      directories so a dropped binary there cannot shadow `git`.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/bborbe/Library/Logs/rebase-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/bborbe/Library/Logs/rebase-agent.log</string>
</dict>
</plist>
