<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fleet pusher watchdog — report a dead cadence, ask nothing.

  WHY THIS IS A SEPARATE JOB: the pusher tick cannot report its own death. If the tick is the
  thing that stopped, nothing inside it runs. This is a second, independent launchd agent whose
  only job is to read the first one's heartbeat and say so when it ages past 1800 s (2x the
  tick's StartInterval, so one slow tick raises nothing).

  It posts a CONDITION, not a question — an `ack` card, deduped on a fixed key so a long outage
  yields one card rather than one per check.

  Install:
    cp launchd/com.bborbe.fleet-pusher-watch.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.bborbe.fleet-pusher-watch.plist

  Remove:
    launchctl bootout gui/$UID/com.bborbe.fleet-pusher-watch

  The script path is the marketplace clone, not a version-pinned cache dir — same reason as
  com.bborbe.fleet-pusher.plist.

  ⚠️ System PATH only, and that is sufficient here: the watchdog reads a file, runs python3, and
  invokes its sibling `attention-ask.py` by a path resolved from its OWN directory. It never
  calls wezterm, so it does not need the WezTerm directory the pusher plist carries.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bborbe.fleet-pusher-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bborbe/.claude/plugins/marketplaces/claude-supervisor/scripts/fleet-pusher-watch.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/bborbe/Library/Logs/fleet-pusher-watch.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/bborbe/Library/Logs/fleet-pusher-watch.log</string>
</dict>
</plist>
